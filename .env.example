# Credit Report Analyzer - Configuración de Ejemplo
# Copia este archivo a .env y completa tus valores

# OpenRouter API Key
# Obtén tu key en: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here

# Modelo predeterminado (opcional)
# Ejemplos: anthropic/claude-3.5-sonnet, openai/gpt-4-turbo, google/gemini-pro
DEFAULT_MODEL=anthropic/claude-3.5-sonnet

# Configuración de límites (opcional)
MAX_FILE_SIZE_MB=50
MAX_IMAGE_SIZE_MB=20

# Modo de desarrollo (opcional)
# true = abre DevTools automáticamente
DEV_MODE=false
